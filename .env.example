APP_NAME=FAQ-Bot
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=2048
LOG_LEVEL=INFO
FAQ_INPUT_FILE=./data/faq.csv
CONTENT_CONFIG_FILE=./content_config.yaml
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=faq-bot-demo
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
RAG_MIN_SCORE_GAP=0.1
ENABLE_PROFILER=false
PROFILER_SAMPLE_RATE=0.1
PROFILER_OUTPUT_PATH=./load-profiler.html
PROFILER_OUTPUT_FORMAT=html
