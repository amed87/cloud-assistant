APP_NAME=Cloud Assistant
APP_VERSION=0.1.0

# LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma:2b

# Logging
LOG_LEVEL=INFO

# Vektordatenbank
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=cloud-assistant

# RAG-Filterkriterien
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# Load-Profiler
ENABLE_PROFILER=True
PROFILER_SAMPLE_RATE=0.1
PROFILER_OUTPUT_PATH=./load-profiler.html