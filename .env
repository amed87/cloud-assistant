APP_NAME=Cloud Assistant
APP_VERSION=0.1.0

# FAQ-Input-Datei
FAQ_INPUT_FILE=C:/Users/j.geiser/Downloads/Tabelle_Chatbotfragen(Tabelle1).csv

# Inhalts-Config-Datei
CONTENT_CONFIG_FILE=./content_config.yaml

# LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=2048

# Logging
LOG_LEVEL=INFO

# Konversationshistorie
NUMBER_OF_TURNS=0

# Vektordatenbank
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=test

# RAG-Filterkriterien
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
RAG_MIN_SCORE_GAP=0.1

# Load-Profiler
ENABLE_PROFILER=False
PROFILER_SAMPLE_RATE=0.1
PROFILER_OUTPUT_PATH=./analytics/load-profiler.html
PROFILER_OUTPUT_FORMAT=html